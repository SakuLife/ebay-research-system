USE_MOCKS=1
RUN_MARKET=UK

EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=

GOOGLE_SERVICE_ACCOUNT_JSON=
SHEETS_SPREADSHEET_ID=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# 楽天ウェブサービス（2026年のインフラ刷新で accessKey が必須になった）
# ⚠️ ACCESS_KEY が無いと楽天は自動的に無効化される。アプリ管理画面から取得すること
# 旧エンドポイント app.rakuten.co.jp は廃止済み（全API一律で503 "under maintenance"）
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=
RAKUTEN_AFFILIATE_ID=
# 通常は空でよい。HTTP_REFERRER_MISSING/NOT_ALLOWED が出たときだけ、
# アプリ登録の Allowed websites と一致するURLを入れる
# ⚠️ 楽天のドメイン（rakuten.co.jp等）はIP制限で弾かれるので入れないこと
RAKUTEN_REFERER=

AMAZON_ACCESS_KEY_ID=
AMAZON_SECRET_ACCESS_KEY=
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=JP

# Yahoo!ショッピング（任意。3つ目の仕入先）
YAHOO_APP_ID=

# SerpApi（Google Shopping。直APIが全滅した時のフォールバック仕入先・有料）
# ⚠️ 変数名は SERP_API_KEY。SERPAPI_API_KEY と書くと読まれず無効になる
SERP_API_KEY=

DISCORD_WEBHOOK_URL=
