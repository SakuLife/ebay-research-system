USE_MOCKS=1
RUN_MARKET=UK

EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=

GOOGLE_SERVICE_ACCOUNT_JSON=
SHEETS_SPREADSHEET_ID=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# 楽天ウェブサービス（2026年のインフラ刷新で accessKey が必須になった）
# ⚠️ ACCESS_KEY が無いと楽天は自動的に無効化される。アプリ管理画面から取得すること
# 旧エンドポイント app.rakuten.co.jp は廃止済み（全API一律で503 "under maintenance"）
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=
RAKUTEN_AFFILIATE_ID=
# 必須。アプリ登録の Allowed websites に入れたドメインと一致させること
# （未設定だと 403 REQUEST_CONTEXT_BODY_HTTP_REFERRER_MISSING）
# ⚠️ 楽天のドメイン（rakuten.co.jp等）はIP制限で弾かれる。localhost も503になる
RAKUTEN_REFERER=https://github.com/

AMAZON_ACCESS_KEY_ID=
AMAZON_SECRET_ACCESS_KEY=
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=JP

# Yahoo!ショッピング（任意。3つ目の仕入先）
YAHOO_APP_ID=

# SerpApi（Google Shopping経由で国内サイトを横断検索・有料）
# ⚠️ 変数名は SERP_API_KEY。SERPAPI_API_KEY と書くと読まれず無効になる
SERP_API_KEY=

# SerpApiをいつ呼ぶか（クレジット消費に直結）
#   smart    … 既定。楽天だけで十分な利益が出ている商品は省く（判断は変えずに節約）
#   always   … 毎回呼ぶ。最安値の精度は最大だが消費も最大
#   fallback … 楽天が0件のときだけ。消費最小だが楽天より安い店を取り逃す
SOURCING_SERPAPI_MODE=smart

DISCORD_WEBHOOK_URL=
